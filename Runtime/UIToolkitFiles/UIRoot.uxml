<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="safe-area" style="flex-grow: 1;">
        <ui:VisualElement name="hud-layer" picking-mode="Ignore" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 255, 0, 0);"/>
        <ui:VisualElement name="view-container" picking-mode="Ignore" style="flex-grow: 1; -unity-background-image-tint-color: rgb(255, 0, 0); background-color: rgba(255, 0, 0, 0);"/>
        <ui:VisualElement name="overlay-layer" picking-mode="Ignore" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; -unity-background-image-tint-color: rgb(0, 0, 255); background-color: rgba(0, 0, 255, 0);"/>
    </ui:VisualElement>
</ui:UXML>
