<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="main-menu" style="flex-grow: 1; justify-content: space-around; flex-direction: column; width: 100%; height: 100%; max-height: none; align-self: center; align-content: flex-start; align-items: stretch; color: rgb(0, 0, 0); background-color: rgb(0, 0, 0);">
        <ui:VisualElement name="title" style="flex-grow: 1; justify-content: center;">
            <ui:Label text="AR Scenes" name="title-text" style="background-color: rgba(255, 255, 255, 0); color: rgb(255, 255, 255); align-self: center; font-size: 35px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="buttons" style="flex-grow: 1; justify-content: space-evenly;">
            <ui:Button text="Start" name="start-button"/>
            <ui:Button text="Map" name="map-menu-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
