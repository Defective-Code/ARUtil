<UXML xmlns="UnityEngine.UIElements">
    <VisualElement name="ar-session-ui" style="flex-grow: 1;">
        <Slider name="stabilization-loading" low-value="0" high-value="1"
                style="position: absolute; bottom: 40px; left: 20px; right: 20px;" />
        <Button name="reset-anchor-button" text="Reset Anchor"
                style="position: absolute; bottom: 80px; left: 20px; width: 150px;" />
    </VisualElement>
</UXML>