<UXML xmlns="UnityEngine.UIElements" editor-extension-mode="False">
    <VisualElement name="ar-session-ui" style="flex-grow: 1; justify-content: center; position: absolute; width: 100%; height: 100%; top: 0; left: 1px;">
        <Slider name="stabilization-loading" low-value="0" high-value="1" style="position: relative; bottom: auto; left: auto; right: auto; align-self: center; height: 29px; width: 70%; justify-content: flex-start; min-width: auto; max-width: 250px; min-height: auto; max-height: none;"/>
        <Label text="Session State" name="session-label" style="position: absolute; top: 11px; left: 11px; color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0);"/>
        <VisualElement name="anchor-panel" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgb(0, 0, 0); color: rgb(255, 255, 255);">
            <ListView name="anchor-list" data-source="project://database/Assets/ScriptableObjects/AnchorData.asset?fileID=11400000&amp;guid=fe63ce973a07f274fac550d4b9729072&amp;type=2#AnchorData" style="position: relative; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0);"/>
            <Button text="Clear All" name="anchor-clear-button" style="background-color: rgb(188, 188, 188);"/>
        </VisualElement>
        <Button name="anchor-panel-button" text="Toggle Anchor List" style="position: absolute; top: 85px; right: 2px; width: 137px; display: flex;"/>
    </VisualElement>
</UXML>
